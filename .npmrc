# Electron / electron-builder 二进制镜像（国内网络环境需要）。
# 若你的网络可直连 GitHub，可删除本文件。
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# npm 11 的安装脚本白名单：Electron 需要 postinstall 下载运行时二进制。
# 这里仅在项目内放行，不改动你的全局 npm 配置。
allow-scripts=opencode-ai,electron,esbuild,electron-winstaller
