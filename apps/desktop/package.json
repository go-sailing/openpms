{
  "name": "@openpms/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OpenPMS 桌面客户端（Electron，内置后端）",
  "author": "OpenPMS",
  "homepage": "https://github.com/go-sailing/openpms",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stage": "node scripts/stage.mjs",
    "start": "electron .",
    "dist": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "ai.openpms.desktop",
    "productName": "OpenPMS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/server",
        "to": "server"
      },
      {
        "from": "dist/web",
        "to": "web"
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "executableName": "openpms",
      "maintainer": "OpenPMS <openpms@example.com>",
      "artifactName": "OpenPMS-${version}-${arch}.${ext}"
    }
  }
}
